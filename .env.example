# Local-only machine configuration. Copy to .env if you use a shell loader.
AUTHOR_AGENT_WEBSITE_REPO=/home/you/path/to/yokstories-site
AUTHOR_AGENT_LOG_LEVEL=INFO

# v25 Meta publishing (publishing remains disabled until explicitly enabled in settings)
META_ACCESS_TOKEN=
AUTHOR_AGENT__META__FACEBOOK_PAGE_ID=
AUTHOR_AGENT__META__INSTAGRAM_ACCOUNT_ID=
# Safe defaults:
AUTHOR_AGENT__PUBLISHING__ENABLED=false
AUTHOR_AGENT__PUBLISHING__DRY_RUN=true
AUTHOR_AGENT__AUTOMATION__MODE=manual

# v28 operational safety / alerting
# true/1/yes/on blocks every real publication API call immediately.
PUBLISHING_KILL_SWITCH=false
# Optional Slack-compatible incoming webhook for publication failures.
AUTHOR_AGENT_ALERT_WEBHOOK=
